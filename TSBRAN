-- 2. ANTI-KILL PART
local function sanitizeArea(center, radius)
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and (part.Position - center).Magnitude < radius then
            if part.Name ~= "HumanoidRootPart" then
                part.CanTouch = false
                part.CanQuery = false
            end
        end
    end
end

