local currentTween = nil
local player = Players.LocalPlayer

local function move(target, speed)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and char.Humanoid.Health > 0 then
        local tInfo = TweenInfo.new(speed or moveSpeed, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(root, tInfo, {CFrame = CFrame.new(target)})
        currentTween:Play()
        return currentTween
    end
end

-- STOP LOGIC SAAT MATI
local function onCharAdded(char)
    char:WaitForChild("Humanoid").Died:Connect(function()
        isMoving = false
        if currentTween then currentTween:Cancel() end
    end)
end
if player.Character then onCharAdded(player.Character) end
player.CharacterAdded:Connect(onCharAdded)

-- TOMBOL GO TO END (MAJU)
endBtn.MouseButton1Click:Connect(function()
    if isMoving then return end
    isMoving = true
    
    sanitizeArea(pos12, 100)
    
    local forwardRoute = {
        {pos = pos1, s = moveSpeed}, {pos = pos2, s = moveSpeed}, {pos = pos3, s = moveSpeed},
        {pos = pos4, s = moveSpeed}, {pos = pos5, s = moveSpeed}, {pos = pos6, s = moveSpeed},
        {pos = pos7, s = moveSpeed}, {pos = pos8, s = moveSpeed}, {pos = pos9, s = moveSpeed},
        {pos = pos10, s = fastSpeed}, {pos = pos11, s = 0.5}, {pos = pos12, s = fastSpeed}
    }
    
    for i, data in ipairs(forwardRoute) do
        if not isMoving then break end
        local t = move(data.pos, data.s)
        if t then 
            t.Completed:Wait() 
            if i < #forwardRoute and isMoving then task.wait(normalDelay) end 
        end
    end
    isMoving = false
end)

